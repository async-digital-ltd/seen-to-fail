# Copy this file to .env and adjust it to the PostgreSQL you are running.
# The values below are the ones docker-compose.yml starts.
#
# The two databases must be different. The test database is truncated between
# tests, so pointing both at the same place would erase your development data.

DATABASE_URL=postgresql://seen_to_fail:seen_to_fail@localhost:5432/seen_to_fail_dev
TEST_DATABASE_URL=postgresql://seen_to_fail:seen_to_fail@localhost:5432/seen_to_fail_test
