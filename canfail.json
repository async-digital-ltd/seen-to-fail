{
  "checks": [
    {
      "name": "Type check",
      "checkId": "ci-type-check",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The type check fails.",
      "run": "pnpm typecheck",
      "timeout": 120,
      "evidence": {
        "expect": "typecheck\\$ tsc --noEmit"
      },
      "breaks": [
        {
          "name": "STATUSES loses its as const, so Status widens to string.",
          "file": "packages/filter/src/types.ts",
          "replace": "  'Unproven',\n] as const;",
          "with": "  'Unproven',\n];",
          "expect": "error TS[0-9]+"
        },
        {
          "name": "STALE_AFTER_DAYS is written as a string rather than a number.",
          "file": "packages/server/src/staleness.ts",
          "replace": "export const STALE_AFTER_DAYS = 30;",
          "with": "export const STALE_AFTER_DAYS = '30';",
          "expect": "error TS[0-9]+"
        }
      ]
    },
    {
      "name": "The published page is checked after it is built",
      "checkId": "ci-published-output",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/filter",
        "packages/server",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/check-published-output.sh",
        "tsconfig.base.json"
      ],
      "expected": "The check of the published output fails, so the run does not go green.",
      "run": "pnpm ledger:build && bash scripts/check-published-output.sh",
      "timeout": 120,
      "evidence": {
        "expect": "The published (page|export|output)"
      },
      "breaks": [
        {
          "name": "The build writes a script tag into the page after the page it checked, so the file on disk is not the page it verified.",
          "file": "packages/server/src/ledger/build.ts",
          "replace": "  await writeFile(pagePath, page, 'utf8');",
          "with": "  await writeFile(pagePath, `${page}<script></script>`, 'utf8');",
          "expect": "The published page carries a script"
        },
        {
          "name": "The build reads the commit it was built from as the parent of HEAD, so the page's \"Built from\" lines name a commit the page was not built from.",
          "file": "packages/server/src/ledger/commits.ts",
          "replace": "  return (await git(repositoryRoot, 'rev-parse', 'HEAD')).trim();",
          "with": "  return (await git(repositoryRoot, 'rev-parse', 'HEAD~1')).trim();",
          "expect": "The published page has a \"Built from\" line that does not name [0-9a-f]{40}"
        }
      ]
    },
    {
      "name": "The build refuses to publish a disagreement",
      "checkId": "ledger-export-agreement",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/filter",
        "packages/server",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The build refuses to publish, exits non-zero, and writes no files at all.",
      "run": "pnpm ledger:build",
      "timeout": 120,
      "evidence": {
        "expect": "Built [0-9]+ checks and [0-9]+ runs|so nothing was published"
      },
      "breaks": [
        {
          "name": "One observation dropped from the export, inside the function that builds it, so the page holds one fewer than the ledger.",
          "file": "packages/server/src/ledger/snapshot.ts",
          "replace": "for (const entry of input.contents.observations) {",
          "with": "for (const entry of input.contents.observations.slice(1)) {",
          "expect": "The number of observations published: the record says [0-9]+ and the export says [0-9]+"
        },
        {
          "name": "The status tally counts nothing, so every tile on the page says zero however many checks hold that status.",
          "file": "packages/server/src/ledger/snapshot.ts",
          "replace": "    counts[check.status] += 1;",
          "with": "    counts[check.status] += 0;",
          "expect": "Checks holding the status [A-Za-z]+: the record says [1-9][0-9]* and the export says 0"
        }
      ]
    },
    {
      "name": "The ledger refuses a malformed record",
      "checkId": "ledger-record-validation",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".github/workflows/record-run.yml",
        ".github/workflows/replay.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/server",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The validator refuses the ledger and exits non-zero, and nothing is recorded.",
      "run": "pnpm ledger:validate",
      "timeout": 60,
      "evidence": {
        "expect": "is sound: [0-9]+ checks|problems?\\. Nothing was recorded\\."
      },
      "breaks": [
        {
          "name": "A run file whose outcome is a word the ledger does not know.",
          "file": "ledger/runs/2026-09-18-ledger-record-validation-718c6198ebf1.json",
          "replace": "\"outcome\": \"caught\"",
          "with": "\"outcome\": \"passed\"",
          "expect": "outcome: Invalid option"
        },
        {
          "name": "A run file naming a check that is not in the ledger.",
          "file": "ledger/runs/2026-09-18-ledger-record-validation-718c6198ebf1.json",
          "replace": "\"checkId\": \"ledger-record-validation\"",
          "with": "\"checkId\": \"ledger-record-validatio\"",
          "expect": "There is no check in the ledger with the id"
        }
      ]
    },
    {
      "name": "Workflow lint",
      "checkId": "ci-workflow-lint",
      "dependsOn": [
        ".github/workflows",
        "canfail.json",
        "package.json",
        "scripts"
      ],
      "expected": "The workflow lint or the script lint fails.",
      "run": "pnpm lint:workflows",
      "timeout": 120,
      "evidence": {
        "expect": "The workflow lint (passed|failed)"
      },
      "breaks": [
        {
          "name": "record-run.yml reads inputs.check_id where the input is named check-id, which GitHub reads as an empty string rather than an error.",
          "file": ".github/workflows/record-run.yml",
          "replace": "          INPUT_CHECK_ID: ${{ inputs.check-id }}\n          INPUT_RUN_ON: ${{ inputs.run-on }}\n          INPUT_PLANTED:",
          "with": "          INPUT_CHECK_ID: ${{ inputs.check_id }}\n          INPUT_RUN_ON: ${{ inputs.run-on }}\n          INPUT_PLANTED:",
          "expect": "property \"check_id\" is not defined"
        },
        {
          "name": "replay.yml reads inputs.only_due where the input is named only-due, so a dispatch ticked to replay only what is due would replay everything.",
          "file": ".github/workflows/replay.yml",
          "replace": "inputs.only-due }}",
          "with": "inputs.only_due }}",
          "expect": "property \"only_due\" is not defined"
        },
        {
          "name": "check-published-output.sh leaves $page unquoted in its first test, so a path to the page with a space in it would be split into separate words.",
          "file": "scripts/check-published-output.sh",
          "replace": "if [ ! -f \"$page\" ]; then",
          "with": "if [ ! -f $page ]; then",
          "expect": "In scripts/check-published-output\\.sh line [0-9]+:"
        }
      ]
    },
    {
      "name": "The server starts",
      "checkId": "ci-server-start",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/filter",
        "packages/server",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/check-server-starts.sh"
      ],
      "expected": "The server start check fails, so the run does not go green.",
      "run": "bash scripts/check-server-starts.sh",
      "timeout": 120,
      "evidence": {
        "expect": "The server start(ed:| check failed:)"
      },
      "breaks": [
        {
          "name": "The entry point imports ./environment without its file extension, which the type check accepts and Node cannot resolve.",
          "file": "packages/server/src/index.ts",
          "replace": "import './environment.ts';",
          "with": "import './environment';",
          "expect": "the server exited with status [0-9]+ before it was listening\\.[\\s\\S]*ERR_MODULE_NOT_FOUND"
        },
        {
          "name": "The entry point starts a timer where it would listen, so the process stays up and never binds the port.",
          "file": "packages/server/src/index.ts",
          "replace": "server.listen(serverPort, serverHost, () => {",
          "with": "setInterval(() => undefined, 60_000);\nvoid (() => {",
          "expect": "the server never said it was listening within [0-9]+ seconds"
        }
      ]
    },
    {
      "name": "Format check",
      "checkId": "ci-format-check",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc.json",
        "canfail.json",
        "package.json",
        "packages/server/src/staleness.ts",
        "pnpm-lock.yaml"
      ],
      "expected": "The format check fails.",
      "run": "pnpm format:check",
      "timeout": 60,
      "evidence": {
        "expect": "Checking formatting\\.\\.\\."
      },
      "breaks": [
        {
          "name": "REPLAY_AFTER_DAYS loses the semicolon every other statement ends with, which the type check and the tests both accept.",
          "file": "packages/server/src/staleness.ts",
          "replace": "export const REPLAY_AFTER_DAYS = 14;",
          "with": "export const REPLAY_AFTER_DAYS = 14",
          "expect": "\\[warn\\] packages/server/src/staleness\\.ts"
        }
      ]
    },
    {
      "name": "Lint",
      "checkId": "ci-lint",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "eslint.config.js",
        "package.json",
        "packages/web",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The lint fails.",
      "run": "pnpm lint",
      "timeout": 120,
      "evidence": {
        "expect": "\\$ eslint \\."
      },
      "breaks": [
        {
          "name": "The filter hook drops the promise navigate returns without marking it as dropped, which the type check accepts.",
          "file": "packages/web/src/filter/use-filter.ts",
          "replace": "      void navigate(paths.checks({ filter: next }));",
          "with": "      navigate(paths.checks({ filter: next }));",
          "expect": "use-filter\\.ts\\s+[0-9]+:[0-9]+ +error .*@typescript-eslint/no-floating-promises"
        }
      ]
    },
    {
      "name": "Tests",
      "checkId": "ci-test",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/filter",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The tests fail.",
      "run": "pnpm test",
      "timeout": 300,
      "evidence": {
        "expect": "Tests +[0-9]+ (passed|failed)"
      },
      "breaks": [
        {
          "name": "A link's day count accepts a leading zero, so one filter has two links, which the type check accepts.",
          "file": "packages/filter/src/url.ts",
          "replace": "const WHOLE_NUMBER = /^(?:0|[1-9][0-9]*)$/;",
          "with": "const WHOLE_NUMBER = /^[0-9]+$/;",
          "expect": "FAIL +src/url\\.test\\.ts > refuses a day count with a leading zero, and says why"
        }
      ]
    },
    {
      "name": "The client builds",
      "checkId": "ci-build-web",
      "dependsOn": [
        ".github/workflows/ci.yml",
        ".nvmrc",
        "canfail.json",
        "package.json",
        "packages/filter",
        "packages/web",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json"
      ],
      "expected": "The client build fails.",
      "run": "pnpm build:web",
      "timeout": 120,
      "evidence": {
        "expect": "vite v[0-9.]+ building"
      },
      "breaks": [
        {
          "name": "The page's script names /src/main.ts where the entry is /src/main.tsx, which the type check cannot see because it never reads the page.",
          "file": "packages/web/index.html",
          "replace": "<script type=\"module\" src=\"/src/main.tsx\"></script>",
          "with": "<script type=\"module\" src=\"/src/main.ts\"></script>",
          "expect": "Failed to resolve /src/main\\.ts from [^\\n]*index\\.html"
        }
      ]
    }
  ]
}
